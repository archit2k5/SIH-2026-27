# Application Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sih_dms
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih_dms

# JWT & Authentication
JWT_ACCESS_SECRET=sih_dms_access_token_secret_key_change_in_production_2026
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_SECRET=sih_dms_refresh_token_secret_key_change_in_production_2026
JWT_REFRESH_EXPIRY=10d
JWT_MFA_SECRET=sih_dms_mfa_token_secret_key_change_in_production_2026
JWT_MFA_EXPIRY=10m
SHARE_TOKEN_SECRET=sih_dms_share_token_secret_key_2026

# Document Storage (MinIO / Local Object Store)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=case-documents

# SMTP / Email Service
MAIL_PRODUCT_NAME=Secure DMS
MAIL_PRODUCT_URL=http://localhost:5173
SMTP_FROM=noreply@securedms.gov.in
SMTP_SECURE=false
SMTP_PORT=2525
SMTP_MAILTRAP_HOST=smtp.mailtrap.io
SMTP_MAILTRAP_PORT=2525
SMTP_MAILTRAP_USERNAME=
SMTP_MAILTRAP_PASSWORD=

AI_NLP_SERVICE_URL=http://localhost:8000
OLLAMA_MODEL=llama3